\contentsline {figure}{\numberline {IV.5}{\ignorespaces Alur Validasi YAML Tiga Lapis Berbasis \textit {Knowledge Graph}}}{59}{figure.caption.27}%
\contentsline {figure}{\numberline {IV.6}{\ignorespaces \textit {Use Case Diagram} Interaksi Pengguna dengan Sistem GraphRAG}}{60}{figure.caption.28}%
