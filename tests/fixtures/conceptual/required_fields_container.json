{
  "id": "required_fields_container",
  "type": "conceptual",
  "question": "What is the only required field when defining a Container inside a PodSpec, and what does the Container schema allow optionally?",
  "resource": "io.k8s.api.core.v1.Container",
  "scope": "Namespaced",
  "multi_hop": false,
  "ground_truth": {
    "answer": "Based on the Kubernetes API definition, the name field is the only field marked as required on a Container. All other fields are optional: image (the container image to run), ports (a list of ContainerPort objects declaring listened ports), env and envFrom (environment variable injection), resources (a ResourceRequirements object for CPU and memory allocation), volumeMounts (a list of VolumeMount objects), livenessProbe and readinessProbe (Probe objects for health checking), and lifecycle (a Lifecycle object for preStop/postStart hooks). Only name is strictly required by the API schema.",
    "context": [
      "io.k8s.api.core.v1.Container: defines a single application container; name is the only required field per the API schema",
      "io.k8s.api.core.v1.ResourceRequirements: optional resources field on Container defining CPU and memory requests and limits",
      "io.k8s.api.core.v1.Probe: optional livenessProbe, readinessProbe, and startupProbe fields on Container for health checking"
    ],
