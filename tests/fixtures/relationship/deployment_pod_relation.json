{
  "id": "deployment_pod_relation",
  "type": "relationship",
  "question": "How does the Deployment schema reference its Pod template configuration?",
  "resource": "io.k8s.api.apps.v1.Deployment",
  "scope": "Namespaced",
  "multi_hop": true,
  "ground_truth": {
    "answer": "A Deployment defines its Pod configuration through DeploymentSpec, which has four key fields: selector (a LabelSelector that links the Deployment to its Pods), template (a PodTemplateSpec representing the Pod definition — the KG uses a CONTAINS_POD_TEMPLATE edge for this relationship), replicas (the desired Pod count), and strategy (a DeploymentStrategy with type RollingUpdate or Recreate). PodTemplateSpec in turn has a spec field of type PodSpec, making the full schema path: Deployment → DeploymentSpec → PodTemplateSpec → PodSpec.",
    "context": [
      "io.k8s.api.apps.v1.DeploymentSpec: selector (LabelSelector), template (PodTemplateSpec), replicas, and strategy (DeploymentStrategy) define the deployment configuration",
      "io.k8s.api.core.v1.PodTemplateSpec: wraps PodSpec; the spec field defines containers and volumes for Pods created by the Deployment"
    ],
