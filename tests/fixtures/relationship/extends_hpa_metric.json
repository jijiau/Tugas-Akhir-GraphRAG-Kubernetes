{
  "id": "extends_hpa_metric",
  "type": "relationship",
  "question": "How does HorizontalPodAutoscalerSpec define its metric sources, and what types does MetricSpec support?",
  "resource": "io.k8s.api.autoscaling.v2.HorizontalPodAutoscaler",
  "scope": "Namespaced",
  "multi_hop": true,
  "ground_truth": {
    "answer": "HorizontalPodAutoscalerSpec includes a metrics field that is a list of MetricSpec objects. The EXTENDS relationship in the KG represents the allOf composition between HPA and its metric type hierarchy. MetricSpec has a type field that selects the metric variant: Resource, Pods, Object, External, or ContainerResource. Each variant has a corresponding source sub-schema (ResourceMetricSource, PodsMetricSource, ObjectMetricSource, etc.). This relationship is only visible through the knowledge graph — a vector search alone cannot reveal the allOf composition structure.",
    "context": [
      "io.k8s.api.autoscaling.v2.HorizontalPodAutoscalerSpec: metrics field is a list of MetricSpec objects defining the scaling criteria; also contains scaleTargetRef, minReplicas, maxReplicas",
      "io.k8s.api.autoscaling.v2.MetricSpec: type field selects the metric variant among Resource, Pods, Object, External, and ContainerResource; each variant has a dedicated source sub-schema"
