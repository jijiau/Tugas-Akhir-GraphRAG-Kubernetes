{
  "id": "service_selector",
  "type": "relationship",
  "question": "What field in ServiceSpec identifies which Pods a Service targets, and how are port forwarding rules defined in the schema?",
  "resource": "io.k8s.api.core.v1.Service",
  "scope": "Namespaced",
  "multi_hop": true,
  "ground_truth": {
    "answer": "Service uses the selector field in ServiceSpec to match Pod labels. The selector is a map of key-value string pairs — a Pod is selected when its labels contain all entries in the selector map. ServiceSpec.ports defines the port forwarding rules: the port field is the Service's exposed port, and targetPort identifies the corresponding Container port (by number or by the name declared in ContainerPort.name).",
    "context": [
      "io.k8s.api.core.v1.ServiceSpec: selector field is a label map identifying Pods that belong to this Service; ports defines the Service's port-to-targetPort forwarding rules",
      "io.k8s.api.core.v1.ContainerPort: name or number of this port is referenced by ServiceSpec.ports.targetPort to route Service traffic to the correct container port"
    ],
