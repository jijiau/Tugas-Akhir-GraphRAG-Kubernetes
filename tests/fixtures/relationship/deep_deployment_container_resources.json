{
  "id": "deep_deployment_container_resources",
  "type": "relationship",
  "question": "How are resource limits and requests for a container inside a Deployment defined in the API schema?",
  "resource": "io.k8s.api.apps.v1.Deployment",
  "scope": "Namespaced",
  "multi_hop": true,
  "ground_truth": {
    "answer": "Defining resource limits and requests requires a four-hop traversal through the schema: Deployment → DeploymentSpec → PodTemplateSpec → Container → ResourceRequirements. The resources field on Container is of type ResourceRequirements, which has two sub-fields: limits (the maximum CPU/memory the container may use) and requests (the minimum CPU/memory reserved for the container). Both limits and requests are maps from resource name to Quantity. Example values: resources.limits.cpu: \"500m\", resources.requests.memory: \"128Mi\".",
    "context": [
      "io.k8s.api.apps.v1.DeploymentSpec: template field (PodTemplateSpec) defines the Pod configuration; the path to container resources begins here",
      "io.k8s.api.core.v1.PodTemplateSpec: spec field is PodSpec, which holds the containers list",
      "io.k8s.api.core.v1.Container: resources field is a ResourceRequirements object defining CPU and memory requests and limits",
      "io.k8s.api.core.v1.ResourceRequirements: limits and requests fields are maps from resource name string to Quantity; defines the container's CPU and memory allocation"
    ],
