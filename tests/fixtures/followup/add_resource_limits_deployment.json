{
  "id": "add_resource_limits_deployment",
  "type": "followup",
  "context_question": "Create a YAML Deployment for nginx",
  "question": "Now add resource requests and limits for that container: request CPU 100m memory 128Mi, limit CPU 500m memory 512Mi",
  "resource": "io.k8s.api.apps.v1.Deployment",
  "scope": "Namespaced",
  "multi_hop": true,
  "ground_truth": {
    "answer": "Add resources to the container spec:\n```yaml\nspec:\n  template:\n    spec:\n      containers:\n      - name: app\n        resources:\n          requests:\n            cpu: 100m\n            memory: 128Mi\n          limits:\n            cpu: 500m\n            memory: 512Mi\n```",
    "context": [
      "io.k8s.api.core.v1.ResourceRequirements: requests field specifies minimum guaranteed resources; limits field specifies the maximum allowed resources for CPU and memory",
      "io.k8s.api.core.v1.Container: resources field holds a ResourceRequirements object defining the container's CPU and memory allocation"
    ],
    "relevant_nodes": [
