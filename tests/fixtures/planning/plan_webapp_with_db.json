{
  "id": "plan_webapp_with_db",
  "type": "planning",
  "question": "I want to deploy a Node.js web application connected to a PostgreSQL database in Kubernetes. What K8s resources need to be created and in what order?",
  "resource": "io.k8s.api.apps.v1.Deployment",
  "scope": "Namespaced",
  "multi_hop": true,
  "ground_truth": {
    "answer": "Resources to create and their order: (1) Namespace — create a separate namespace for isolation; (2) Secret — store the database password (do not hardcode in YAML); (3) ConfigMap — store non-sensitive configuration such as database name and host; (4) PersistentVolumeClaim — for PostgreSQL storage so data persists independently of the Pod lifecycle; (5) StatefulSet for PostgreSQL — databases need stable identity and per-Pod persistent storage via PVC, not Deployment; (6) ClusterIP Service for PostgreSQL — so Node.js can reach the database via internal cluster DNS; (7) Deployment for Node.js — inject the connection string from ConfigMap and Secret; (8) Service for Node.js — expose within the cluster or externally; (9) Ingress — if Node.js needs to be accessed from the internet via HTTP.",
    "context": [
      "io.k8s.api.apps.v1.StatefulSet: suited for PostgreSQL because it provides stable Pod identity and per-Pod persistent storage via volumeClaimTemplates",
      "io.k8s.api.apps.v1.Deployment: suited for stateless workloads like Node.js that can be scaled horizontally",
      "io.k8s.api.core.v1.PersistentVolumeClaim: provides PostgreSQL storage with a lifecycle independent of the Pod",
      "io.k8s.api.core.v1.Secret: stores sensitive data such as database credentials; values are base64-encoded in the API representation",
      "io.k8s.api.core.v1.Service: provides internal cluster networking between components via DNS-based service discovery"
    ],
