{
  "id": "plan_autoscale_ha",
  "type": "planning",
  "question": "My application needs to auto-scale when traffic is high and remain available without downtime when updated to a new version. What Kubernetes setup should I create?",
  "resource": "io.k8s.api.apps.v1.Deployment",
  "scope": "Namespaced",
  "multi_hop": true,
  "ground_truth": {
    "answer": "For auto-scaling and zero-downtime updates, create: (1) Deployment with strategy.type RollingUpdate and at least 2 minReplicas — one Pod always runs during an update; (2) Resource requests and limits must be set on all containers — HPA uses requests.cpu as the baseline to calculate utilization percentages; (3) HorizontalPodAutoscaler (HPA) referencing the Deployment — set minReplicas, maxReplicas, and targetCPUUtilizationPercentage; (4) ReadinessProbe on the container — Kubernetes only routes traffic to Pods that are ready, so new Pods do not receive requests before the application is fully up; (5) PodDisruptionBudget — guarantees a minimum number of Pods remain running during node maintenance or cluster updates.",
    "context": [
      "io.k8s.api.apps.v1.DeploymentStrategy: RollingUpdate with maxUnavailable=0 guarantees zero downtime during updates",
      "io.k8s.api.autoscaling.v2.HorizontalPodAutoscaler: auto-scales based on CPU or memory metrics defined in HorizontalPodAutoscalerSpec",
      "io.k8s.api.core.v1.Probe: readinessProbe ensures traffic is only routed to Pods that have passed their health check",
      "io.k8s.api.policy.v1.PodDisruptionBudget: guarantees minimum Pod availability during voluntary disruptions such as node maintenance"
    ],
